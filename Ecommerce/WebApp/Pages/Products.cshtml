@page
@model WebApp.Pages.ProductsModel
@{


<script src="~/js/pages/ProductViewController.js"></script>

<h1>Listado de Productos</h1>
<div class="bs-docs-section">
    <div class="row">
        <fieldset>
            <legend>Listado</legend>
            <div class="col-lg-12">
                <table id="tblProducts" class="display" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Precio</th>
                            <th>Cantidad</th>
                            <th>Categoría</th>
                            <th>Registro</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </fieldset>
    </div>
    <div class="row">
        <div class="col-lg-6">
            <div class="bs-bs-component">
            <form>
                <fieldset>
                    <legend>Edición</legend>
                    <div class="form-group">
                        <label for="txtId" class="form-label mt-4">ID</label>
                        <input id="txtId" readonly type="number" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label for="txtName" class="form-label mt-4">Nombre</label>
                        <input id="txtName" type="text" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label for="txtDescription" class="form-label mt-4">Descripción</label>
                        <input id="txtDescription" type="text" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label for="txtPrice" class="form-label mt-4">Precio</label>
                        <input id="txtPrice" type="number" step="0.01" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label for="txtQuantity" class="form-label mt-4">Cantidad</label>
                        <input id="txtQuantity" type="number" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label for="txtCategory" class="form-label mt-4">Categoría</label>
                        <input id="txtCategory" type="text" class="form-control" />
                    </div>
                    </fieldset>
                </form>
                <br />
                <button id="btnCreate" class="btn btn-primary btn-xs" type="button">Crear</button>
                <button id="btnUpdate" class="btn btn-secondary btn-xs" type="button">Actualizar</button>
                <button id="btnDelete" class="btn btn-danger btn-xs" type="button">Eliminar</button>

            </div>
        </div>
    </div>
</div>
}